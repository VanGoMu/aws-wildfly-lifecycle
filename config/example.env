# aws-wildfly-lifecycle · the only configuration.
#
# Copy this file to config/<env>.env (config/dev.env for ENV_NAME=dev) and change what you need.
# An environment variable with the same name wins over the file: the GitHub workflows copy this
# file and set ENV_NAME and AWS_REGION. Plain KEY=value lines, without quotes. bin/*.sh validate
# every key.

# Environment name: part of every resource name (wfl-<env>-…). Also chosen with ENV_NAME=… in the
# environment; dev by default.
ENV_NAME=dev
AWS_REGION=eu-west-1

# An existing VPC and two subnets in different Availability Zones (the ALB needs two). blue goes to
# the first subnet and green to the second. No default: bin/alb.sh and bin/instance.sh ask for them.
# VPC_ID=vpc-0123456789abcdef0
# SUBNET_IDS=subnet-0123456789abcdef0,subnet-0fedcba9876543210
VPC_ID=
SUBNET_IDS=
# false for private subnets with a NAT gateway or the VPC endpoints listed in the README.
ASSIGN_PUBLIC_IP=true
# 1 GiB is enough for the default WildFly heap; t3.small otherwise.
INSTANCE_TYPE=t3.micro

# false = no load balancer, for tests: everything works without bin/alb.sh, without canary.
USE_ALB=true
# Direct access to the instances without ALB, and to the ALB test listener (:8081) with it.
ALLOWED_CIDR=203.0.113.10/32
# Who reaches the production listener.
ALB_INGRESS_CIDR=0.0.0.0/0
# Empty = HTTP only. With an ACM certificate: listener 443 and a redirect from 80.
CERTIFICATE_ARN=

# Canary. Weights are relative: 10 means 90/10; 0 = no canary. The minutes are fixed when the
# runbook is registered (Observe = CANARY_MINUTES + 2 min): changing them is bin/setup.sh up.
CANARY_WEIGHT=10
CANARY_MINUTES=5
# Minimum requests to the new color during the canary; 0 = not required.
CANARY_MIN_REQUESTS=0

# APP_NAME names the revision (releases/<APP_NAME>/…), not a WAR. One of the WARs must serve
# HEALTH_PATH: it is what the ALB checks.
APP_NAME=wildfly-demo
APP_PORT=8080
HEALTH_PATH=/health

WILDFLY_VERSION=35.0.1.Final
WILDFLY_SHA256=45444ac28f33ee17101cf80b9eff7994f6fd0f2c8fbb4749627d9cec1cbdbc2e
JAVA_PACKAGE=java-21-amazon-corretto-headless
# The full build, as in releases/codedeploy-agent-<version>.<arch>.rpm of the regional
# aws-codedeploy-<region> bucket: 2.1.2 alone is not a key there.
CODEDEPLOY_AGENT_VERSION=2.1.2-17389362373
# Shipped inside the configuration release. The 10.x branch needs ansible-core >= 2.15, the one of
# Amazon Linux 2023; 11.x already needs 2.16.
COMMUNITY_GENERAL_VERSION=10.7.9
COMMUNITY_GENERAL_SHA256=7d88906f7d62d6e2bab6a38b20eac51479766c536d2efd652b3d396b9dc90e2c

# AMI backups kept per environment.
AMI_BACKUPS_KEEP=2

# owner/repo whose workflows may assume the GitHub role; empty = no role. Your fork, never someone
# else's: that repository could deploy to your account. CREATE_OIDC_PROVIDER=true only if the
# account does not have the token.actions.githubusercontent.com provider yet (one per account).
GITHUB_REPOSITORY=
CREATE_OIDC_PROVIDER=false
